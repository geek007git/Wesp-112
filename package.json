{
  "name": "doctor-appointment-system",
  "version": "1.0.0",
  "description": "MERN doctor appointment system: doctor applications with admin approval, appointment booking with slot availability checks, and in-app notifications.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm start --prefix ./client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "keywords": [
    "mern",
    "express",
    "mongodb",
    "react",
    "appointments"
  ],
  "author": "geek007git",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/geek007git/Wesp-112.git"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "colors": "^1.4.0",
    "concurrently": "^7.6.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.7.2",
    "morgan": "^1.10.0",
    "nodemon": "^2.0.20"
  }
}
